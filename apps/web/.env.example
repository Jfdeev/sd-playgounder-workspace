# Copie para .env.local (nunca commitado) e preencha com valores reais.
# Nunca cole segredos reais em nenhum outro lugar (chat, commits, issues).

# Connection string do seu projeto Neon (Postgres serverless) — ADR-005.
DATABASE_URL=

# Chave de assinatura de sessão do Auth.js — gere com: npx auth secret
AUTH_SECRET=

# Google OAuth (ADR-007) — console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (envio do email de confirmação, FR-013a) — resend.com/api-keys.
# Opcional nesta fase: sem esta chave, contas continuam sendo criadas e funcionais,
# só o email de confirmação não é enviado (falha é logada, não bloqueia nada) —
# ver specs/landing-page-conta-m0-5/research.md §4.
RESEND_API_KEY=
