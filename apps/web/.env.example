# Copie para .env.local (nunca commitado) e preencha com valores reais.
# Nunca cole segredos reais em nenhum outro lugar (chat, commits, issues).

# Connection string do seu projeto Neon (Postgres serverless) — ADR-005.
DATABASE_URL=

# Chave de assinatura de sessão do Auth.js — gere com: npx auth secret
AUTH_SECRET=

# Google OAuth (ADR-007) — console.cloud.google.com > APIs & Services > Credentials.
# Nomes lidos explicitamente em src/auth.ts (Google({ clientId:, clientSecret: })) — o Auth.js
# v5 só infere AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET quando esses campos NÃO são passados; como o
# provider aqui os passa explicitamente, use exatamente estes dois nomes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de emails por SMTP (confirmação, redefinição de senha, aviso de cadastro). Padrão: Gmail.
# SMTP_USER = a conta Gmail do projeto; SMTP_PASSWORD = uma "senha de app" do Google (myaccount.google.com/apppasswords,
# exige verificação em 2 etapas) — NUNCA a senha normal da conta. Sem usuário/senha, nenhum email sai (só log)
# e o resto do app funciona normalmente.
SMTP_USER=
SMTP_PASSWORD=
# Opcionais: servidor (padrão smtp.gmail.com), porta (padrão 465) e remetente (padrão "System Design Playground <SMTP_USER>").
SMTP_HOST=
SMTP_PORT=
EMAIL_FROM=

# Google Gemini (narrador do resultado, M2 — modelo gemini-2.5-flash) — aistudio.google.com/apikey.
# Server-only: lida só em apps/web/src/app/api/narrator/route.ts, nunca em Client Component
# (mesma regra do RESEND_API_KEY acima). Sem esta chave, o Route Handler do narrador devolve
# PROVIDER_UNAVAILABLE — o resultado do engine (utilização, gargalo, latência, custo, score)
# continua funcionando normalmente (FR-010, o narrador nunca bloqueia o resultado determinístico).
GEMINI_API_KEY=

# Cabeçalho com o IP real do cliente, garantido pela hospedagem (ex.: x-real-ip, x-vercel-forwarded-for).
# Vazio: usa o último valor de X-Forwarded-For (o do proxy mais próximo). Ver src/lib/client-ip.ts.
CLIENT_IP_HEADER=
